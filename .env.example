# Supabase. Server-side only — these are read by api/ functions, not bundled
# into the frontend (no VITE_ prefix). The anon key is safe to expose; the
# service role key bypasses Row Level Security and must never reach a client.
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
# Required by scripts/build-kb.js and by the admin FAQ writes.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JSearch API (RapidAPI) — powers Career Explorer. Live when set; without it the
# page serves the accumulated cache, then simulated listings.
JSEARCH_API_KEY=your-jsearch-rapidapi-key

# Signs the admin session cookie (HMAC-SHA256, see api/_lib/session.js).
# REQUIRED IN PRODUCTION. Without it the code falls back to a value published in
# this repository, so every admin route refuses to run (503) rather than accept a
# cookie anyone could forge. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Demo admin credentials. Only reachable when Supabase is NOT configured, so
# they are unusable in a real deployment. Override them anyway.
ADMIN_DEMO_EMAIL=admin@dme.kku.ac.th
ADMIN_DEMO_PASSWORD=demo1234
